"""Marketing consent in the registration flow — signup form, signal, adapter, completion."""
import pytest
from django.test import RequestFactory
from django.urls import reverse

from apps.users.adapter import (
    _PROMPT_FLAG,
    AccountAdapter,
    flag_social_signup_for_marketing_prompt,
)
from apps.users.forms import MarketingSignupForm


@pytest.mark.django_db
def test_signup_form_records_consent(user):
    """Test that the signup form records the opt-in and marks the user prompted."""
    form = MarketingSignupForm({"marketing_emails": "on"})
    assert form.is_valid()
    form.signup(RequestFactory().get("/"), user)

    user.refresh_from_db()
    assert user.marketing_emails is True
    assert user.marketing_prompted is True


@pytest.mark.django_db
def test_signup_form_unchecked_still_marks_prompted(user):
    """Test that declining marketing still marks the user as prompted."""
    form = MarketingSignupForm({})
    assert form.is_valid()
    form.signup(RequestFactory().get("/"), user)

    user.refresh_from_db()
    assert user.marketing_emails is False
    assert user.marketing_prompted is True


@pytest.mark.django_db
def test_social_signup_signal_sets_session_flag(user, rf):
    """Test that a social sign-up flags the session for the marketing prompt."""
    request = rf.get("/")
    request.session = {}
    flag_social_signup_for_marketing_prompt(request=request, user=user, sociallogin=object())
    assert request.session[_PROMPT_FLAG] is True


@pytest.mark.django_db
def test_email_signup_signal_does_not_flag(user, rf):
    """Test that an email sign-up does not flag the session (answered on the form)."""
    request = rf.get("/")
    request.session = {}
    flag_social_signup_for_marketing_prompt(request=request, user=user, sociallogin=None)
    assert _PROMPT_FLAG not in request.session


@pytest.mark.django_db
def test_adapter_routes_flagged_request_to_completion(user, rf):
    """Test that a flagged session redirects once to the completion page."""
    request = rf.get("/")
    request.user = user
    request.session = {_PROMPT_FLAG: True}
    assert AccountAdapter().get_login_redirect_url(request) == reverse("account:complete_profile")
    assert _PROMPT_FLAG not in request.session


@pytest.mark.django_db
def test_adapter_leaves_normal_login_untouched(user, rf):
    """Test that an ordinary login is not redirected to the completion page."""
    request = rf.get("/")
    request.user = user
    request.session = {}
    assert AccountAdapter().get_login_redirect_url(request) != reverse("account:complete_profile")


@pytest.mark.django_db
def test_complete_profile_requires_login(client):
    """Test that anonymous visitors cannot reach the completion page."""
    response = client.get("/account/complete-profile/")
    assert response.status_code == 302


@pytest.mark.django_db
def test_complete_profile_skips_already_prompted_user(client, user):
    """Test that an already-prompted user is redirected away from the completion page."""
    user.marketing_prompted = True
    user.save(update_fields=["marketing_prompted"])
    client.force_login(user)
    response = client.get("/account/complete-profile/")
    assert response.status_code == 302


@pytest.mark.django_db
def test_complete_profile_post_records_consent(client, user):
    """Test that submitting the completion form records consent and marks prompted."""
    client.force_login(user)
    response = client.post("/account/complete-profile/", {"marketing_emails": "on"})

    assert response.status_code == 302
    user.refresh_from_db()
    assert user.marketing_emails is True
    assert user.marketing_prompted is True
