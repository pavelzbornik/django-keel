"""Tests for core application functionality."""
import pytest
from django.urls import reverse


# Health Check Tests


@pytest.mark.django_db
def test_liveness_endpoint(client):
    """django-alive liveness: process is up (T3: the single health mechanism)."""
    response = client.get("/health/alive/")

    assert response.status_code == 200


@pytest.mark.django_db
def test_healthcheck_endpoint(client):
    """django-alive healthcheck runs the configured checks (DB et al.)."""
    response = client.get("/health/health/")

    # 200 when all checks pass, 503 when a dependency is down
    assert response.status_code in [200, 503]


# URL Resolution Tests


@pytest.mark.django_db
def test_core_urls_resolve():
    """Test that core URLs can be resolved."""
    url = reverse("index")
    assert url is not None


@pytest.mark.django_db
def test_admin_url_resolves():
    """Test that admin URL resolves."""
    url = reverse("admin:index")
    assert url == "/admin/"


