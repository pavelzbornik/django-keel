# SEO Surface Tests


@pytest.mark.django_db
def test_robots_txt_returns_200_with_sitemap_line(client):
    """Test that robots.txt is served with a Sitemap directive."""
    response = client.get("/robots.txt")

    assert response.status_code == 200
    assert response["Content-Type"] == "text/plain"
    assert b"Sitemap:" in response.content
    assert b"/sitemap.xml" in response.content


@pytest.mark.django_db
def test_sitemap_returns_200_valid_xml(client):
    """Test that sitemap.xml is served as valid XML listing the index page."""
    response = client.get("/sitemap.xml")

    assert response.status_code == 200
    assert response["Content-Type"] == "application/xml"
    content = response.content.decode("utf-8")
    assert '<?xml version="1.0" encoding="UTF-8"?>' in content
    assert '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' in content
    assert "</urlset>" in content
