{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Change password" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">
                {% if token_fail %}{% trans "Bad token" %}{% else %}{% trans "Change password" %}{% endif %}
            </h1>
            {% if token_fail %}
                {% url 'account_reset_password' as passwd_reset_url %}
                <p class="text-sm text-base-content/70">
                    {% blocktrans %}The password reset link was invalid, possibly because it has already been used. Please request a <a class="link link-primary" href="{{ passwd_reset_url }}">new password reset</a>.{% endblocktrans %}
                </p>
            {% else %}
                <form method="post" action="{{ action_url }}" class="space-y-3">
                    {% csrf_token %}
                    {{ form.as_p }}
                    <button type="submit" class="btn btn-primary btn-block">{% trans "Change password" %}</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
