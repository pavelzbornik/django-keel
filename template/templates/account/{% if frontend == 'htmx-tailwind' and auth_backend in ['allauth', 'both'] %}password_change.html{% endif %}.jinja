{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Change password" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">{% trans "Change password" %}</h1>
            <form method="post" action="{% url 'account_change_password' %}" class="space-y-3">
                {% csrf_token %}
                {{ form.as_p }}
                <button type="submit" class="btn btn-primary btn-block">{% trans "Change password" %}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
