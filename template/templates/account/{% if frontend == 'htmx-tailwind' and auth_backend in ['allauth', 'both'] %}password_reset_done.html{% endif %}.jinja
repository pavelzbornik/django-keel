{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Reset password" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">{% trans "Check your inbox" %}</h1>
            <p class="text-sm text-base-content/70">
                {% trans "We have sent you an email. If you have not received it please check your spam folder. Otherwise contact us if you do not receive it in a few minutes." %}
            </p>
            <p class="text-sm text-base-content/70 mt-4">
                <a class="link link-primary" href="{% url 'account_login' %}">{% trans "Back to sign in" %}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
