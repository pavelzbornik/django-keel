{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Change password" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">{% trans "Password changed" %}</h1>
            <p class="text-sm text-base-content/70">{% trans "Your password is now changed." %}</p>
            <p class="text-sm text-base-content/70 mt-4">
                <a class="link link-primary" href="{% url 'account_login' %}">{% trans "Sign in" %}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
