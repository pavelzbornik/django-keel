{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Create account" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">{% trans "Create your account" %}</h1>
            <form method="post" action="{% url 'account_signup' %}" class="space-y-3">
                {% csrf_token %}
                {{ form.as_p }}
                {% if redirect_field_value %}
                <input type="hidden" name="{{ redirect_field_name }}" value="{{ redirect_field_value }}">
                {% endif %}
                <button type="submit" class="btn btn-primary btn-block">{% trans "Sign up" %}</button>
            </form>
            <p class="text-sm text-base-content/70 mt-4">
                <a class="link link-primary" href="{% url 'account_login' %}">{% trans "Already have an account? Sign in" %}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
