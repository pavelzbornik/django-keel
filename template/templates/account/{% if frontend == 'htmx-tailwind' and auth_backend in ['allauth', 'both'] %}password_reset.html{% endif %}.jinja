{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Reset password" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-md mx-auto">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">{% trans "Reset your password" %}</h1>
            <p class="text-sm text-base-content/70">
                {% trans "Enter your email address and we'll send you a link to reset it." %}
            </p>
            <form method="post" action="{% url 'account_reset_password' %}" class="space-y-3">
                {% csrf_token %}
                {{ form.as_p }}
                <button type="submit" class="btn btn-primary btn-block">{% trans "Reset my password" %}</button>
            </form>
            <p class="text-sm text-base-content/70 mt-4">
                <a class="link link-primary" href="{% url 'account_login' %}">{% trans "Back to sign in" %}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
