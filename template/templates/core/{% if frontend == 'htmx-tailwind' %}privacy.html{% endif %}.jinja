{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Privacy Policy" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<article class="max-w-2xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-base-content">{% trans "Privacy Policy" %}</h1>
    <!-- TODO: this is a scaffold, not legal advice — replace every section below
         with your project's actual privacy policy before shipping to production. -->
    <p class="mt-2 text-sm text-base-content/60">{% trans "Last updated: TODO" %}</p>

    <div class="mt-6 space-y-4 text-sm text-base-content/80">
        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Data we collect" %}</h2>
        <p>{% trans "TODO: list the personal data this project actually collects (e.g. account email, uploaded files)." %}</p>

        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Purpose" %}</h2>
        <p>{% trans "TODO: state why each category of data is collected and how it is used." %}</p>

        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Processors" %}</h2>
        <p>{% trans "TODO: list any third-party processors (payment, email, hosting) that receive this data." %}</p>

        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Retention" %}</h2>
        <p>{% trans "TODO: state how long data is kept, and when it is deleted." %}</p>

        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Your rights (GDPR)" %}</h2>
        {% url 'account:settings' as settings_url %}
        <p>{% blocktrans %}You can export or delete your account data at any time from your <a class="link link-primary" href="{{ settings_url }}">account settings</a>.{% endblocktrans %}</p>

        <h2 class="text-lg font-semibold text-base-content pt-2">{% trans "Contact" %}</h2>
        <p>{% trans "TODO: provide a contact address for privacy questions and data requests." %}</p>
    </div>
</article>
{% endblock %}{% endraw %}
