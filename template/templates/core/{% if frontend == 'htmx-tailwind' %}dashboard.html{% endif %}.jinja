{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Dashboard" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-12">
    <h1 class="text-3xl font-bold text-base-content text-center">{% trans "Dashboard" %}</h1>

    {# First-run empty state. #}
    {# TODO: replace this card with your domain's recent-activity lists once #}
    {# there is data to show (e.g. recent projects, orders, uploads). #}
    <div class="card bg-base-100 shadow-sm mt-8">
        <div class="card-body items-center text-center">
            <h2 class="card-title">{% trans "Welcome to" %} {% endraw %}{{ project_name }}{% raw %}</h2>
            <p class="text-base-content/70">
                {% trans "This is where your recent activity will show up once you get started." %}
            </p>
            <div class="card-actions mt-4">
                <a href="{% url 'index' %}" class="btn btn-primary">{% trans "Start building" %}</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}{% endraw %}
