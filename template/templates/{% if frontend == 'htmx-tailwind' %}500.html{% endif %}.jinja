{% raw %}{% extends "base.html" %}
{% load i18n %}

{% block title %}{% trans "Server Error" %} — {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block content %}{% endraw %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full text-center">
        <!-- 500 Icon -->
        <div class="inline-flex items-center justify-center size-24 rounded-full bg-error/15 mb-8">
            <!-- lucide: server-crash -->
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-error">
                <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>

        <!-- Error Message -->
        <h1 class="text-6xl font-bold text-base-content mb-4">500</h1>
        <h2 class="text-3xl font-semibold text-base-content mb-4">
            {% raw %}{% trans "Server Error" %}{% endraw %}
        </h2>
        <p class="text-lg text-base-content/70 mb-8">
            {% raw %}{% trans "Something went wrong on our end. We have been notified and are working to fix it." %}{% endraw %}
        </p>

        <!-- Help Section -->
        <div class="bg-base-200 border border-base-300 rounded-lg p-6 mb-8 text-left">
            <h3 class="text-lg font-semibold text-base-content mb-3">
                {% raw %}{% trans "What can you do?" %}{% endraw %}
            </h3>
            <ul class="space-y-2 text-base-content">
                <li class="flex items-start">
                    <!-- lucide: check-circle -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-secondary mr-2 mt-0.5 shrink-0">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>{% raw %}{% trans "Wait a few minutes and try again" %}{% endraw %}</span>
                </li>
                <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-secondary mr-2 mt-0.5 shrink-0">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>{% raw %}{% trans "Go back to the homepage" %}{% endraw %}</span>
                </li>
            </ul>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{% raw %}{% url 'index' %}{% endraw %}" class="btn btn-primary btn-lg gap-2">
                <!-- lucide: home -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                {% raw %}{% trans "Back to Homepage" %}{% endraw %}
            </a>
            <a href="javascript:history.back()" class="btn btn-outline btn-lg gap-2">
                <!-- lucide: arrow-left -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                {% raw %}{% trans "Go Back" %}{% endraw %}
            </a>
        </div>
    </div>
</div>
{% raw %}{% endblock %}{% endraw %}
