repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.5.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
      - id: check-json
      - id: check-toml
      - id: check-merge-conflict
      - id: debug-statements

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.4.0
    hooks:
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
      - id: ruff-format

  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.10.0
    hooks:
      - id: mypy
        additional_dependencies:
          - django-stubs
{%- if api_style in ['drf', 'both'] %}
          - djangorestframework-stubs
{%- endif %}

  - repo: local
    hooks:
      - id: arch-contracts
        name: Architecture import contracts (import-linter)
        # Git runs hooks without the project venv activated, so go through the
        # manager - the same as the generated CI does for ruff, mypy and pytest.
        entry: bash -c 'PYTHONPATH=. {% if dependency_manager == 'uv' %}uv run{% else %}poetry run{% endif %} lint-imports --no-logo'
        language: system
        pass_filenames: false
        files: ^(apps/.*\.py|\.importlinter)$
