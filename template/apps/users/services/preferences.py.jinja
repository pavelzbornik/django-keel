"""Email notification preferences (ADR-034 style).

GDPR requires a self-service way to stop non-essential email. The
``email_notifications`` flag gates product-update / marketing mail; transactional
account email is unaffected. Gate any non-essential send on
``user.email_notifications`` (or ``User.objects.filter(email_notifications=True)``).
"""


def set_email_notifications(user, *, enabled):
    """Persist the user's opt-in/out for non-essential notification email."""
    user.email_notifications = enabled
    user.save(update_fields=["email_notifications"])
