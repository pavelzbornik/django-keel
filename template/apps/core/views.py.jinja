    })
{%- endif %}


def robots_txt(request):
    """Serve robots.txt for search engine crawlers.

    Guides search engines on what to crawl and where to find the sitemap.
    """
    content = render_to_string("robots.txt", {"request": request})
    return HttpResponse(content, content_type="text/plain")


def sitemap(request):
    """Generate sitemap.xml listing the public landing page."""
    last_mod = timezone.now().strftime("%Y-%m-%d")

{%- if use_i18n %}
    paths = [f"/{code}/" for code, _name in settings.LANGUAGES]
{%- else %}
    paths = ["/"]
{%- endif %}

    xml_content = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ]

    for path in paths:
        url = request.build_absolute_uri(path)
        xml_content.append("  <url>")
        xml_content.append(f"    <loc>{url}</loc>")
        xml_content.append(f"    <lastmod>{last_mod}</lastmod>")
        xml_content.append("    <changefreq>weekly</changefreq>")
        xml_content.append("    <priority>1.0</priority>")
        xml_content.append("  </url>")

    xml_content.append("</urlset>")

    return HttpResponse("\n".join(xml_content), content_type="application/xml")


